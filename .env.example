# Template for local .env — copy to .env and adjust. This file IS committed;
# .env is not. Never put real secrets here.
#
# Every variable below is read by domowa_apteka/settings.py. In production
# these are set as Railway service variables instead of via a file.

# Turns on debug pages and Django's static-file serving. Must be absent or
# not exactly "True" in production — the settings module compares the string,
# because bool("False") is True in Python.
DEBUG=True

# Signs session cookies and password-reset tokens. Locally, settings.py falls
# back to the scaffold's insecure key if this is unset. In production it MUST
# be set to a fresh value:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SECRET_KEY=

# Comma-separated. Empty entries are filtered out. Defaults to
# localhost,127.0.0.1 when unset — leave it unset for local work.
# ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, each entry needs a scheme. Required for admin login over
# HTTPS behind a TLS-terminating proxy. Leave unset locally; runserver has no
# proxy in front of it, so the failure this prevents cannot occur.
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# The app IS deployed. For the values actually set in production — domain,
# hosts, trusted origins — see context/deployment/deploy-plan.md. Do not copy
# them here; production config lives in Railway service variables, not a file.

# Unset locally, so settings.py falls back to the SQLite file. In production
# this is Railway's internal Postgres reference variable.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
